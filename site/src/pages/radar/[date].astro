---
import { marked } from "marked";
import Base from "../../layouts/Base.astro";
import { loadRadar } from "../../lib/data";
import { linkEpisodes } from "../../lib/format";

export function getStaticPaths() {
  return loadRadar().digests.map((d) => ({ params: { date: d.date }, props: { d } }));
}
const { d } = Astro.props;
const html = linkEpisodes((await marked.parse(d.body, { gfm: true }))
  .replace(/\*\*([A-Z][A-Z.-]{0,6})\*\*/g, "<strong>$1</strong>")
  .replace(/<strong>([A-Z][A-Z.-]{0,6})<\/strong>/g, '<a href="/stock/$1/"><strong>$1</strong></a>'));
---
<Base title={`Radar ${d.date}`}>
  <p><a href="/radar/">← Radar</a></p>
  <article class="prose" set:html={html} />
  <p class="muted small">Automated digest of news and SEC filings, judged against the Rule #1 event rules. Facts and names, not investment advice.</p>
</Base>
<style>.small { font-size: 13px; }</style>
