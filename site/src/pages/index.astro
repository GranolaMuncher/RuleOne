---
import Base from "../layouts/Base.astro";
import ScreenView from "../components/ScreenView.astro";
import { loadRun, loadReports, loadDecisions } from "../lib/data";

const { lists, meta } = loadRun();
const reports = loadReports().filter((r) => r.kind !== "model");
const weeklies = reports.filter((r) => r.kind === "weekly");
const weekly = weeklies.find((r) => r.slug.endsWith("_brief")) ?? weeklies[0];
const memo = weeklies.find((r) => r.slug.endsWith("_rulers") && r.date === weekly?.date);
const weeklyLabel = (slug: string) => slug.endsWith("_brief") ? "Weekly brief" : slug.endsWith("_rulers") ? "RULERS memo" : "Weekly scout";
const dec = loadDecisions();
const dives = reports.filter((r) => r.kind === "deep-dive").slice(0, 4);
---
<Base title="RuleOne">
  <h1>Rule #1 screen of every NYSE &amp; Nasdaq stock</h1>
  <p class="muted lead">
    Run {meta.run_date ?? "–"}, prices as of {meta.price_date ?? "–"}. Wonderful businesses (Phil Town's Big Five)
    valued with Sticker Price, a 50% margin of safety, Payback Time and Ten Cap, plus the events that create bargains.
    Automated Stickers use history-based growth with no analyst haircut, so treat them as upper bounds.
    The <a href="/reports/">research</a> pages apply judgement.
  </p>

  {dec && (dec.actions.length > 0 || dec.decisions.length > 0) && (
    <section class="panel brief">
      <h2>This week <span class="muted">{dec.date}</span></h2>
      <p>{dec.summary}</p>
      {dec.actions.length > 0 && (
        <ul>{dec.actions.map((a) => <li><a href={`/stock/${a.ticker}/`}><strong>{a.ticker}</strong></a> · <span class="chip">{a.action}</span> {a.reason}</li>)}</ul>
      )}
      {dec.decisions.length > 0 && (
        <>
          <h3>Decisions for you</h3>
          <ul>{dec.decisions.map((d) => <li><strong>{d.ticker}</strong>: {d.question} <span class="muted">{d.why}</span>{d.link && <> <a href={d.link}>→</a></>}</li>)}</ul>
        </>
      )}
      {weekly && <p><a href={`/reports/${weekly.slug}/`}>Read the full brief →</a></p>}
    </section>
  )}

  {(weekly || dives.length > 0) && (
    <div class="research">
      {weekly && (
        <a class="panel card" href={`/reports/${weekly.slug}/`}>
          <span class="chip ONDECK">{weeklyLabel(weekly.slug)}</span>
          <strong>{weekly.title}</strong>
          <span class="muted">{weekly.date}</span>
        </a>
      )}
      {memo && (
        <a class="panel card" href={`/reports/${memo.slug}/`}>
          <span class="chip ONDECK">RULERS memo</span>
          <strong>{memo.title}</strong>
          <span class="muted">{memo.date}</span>
        </a>
      )}
      {dives.map((r) => (
        <a class="panel card" href={`/reports/${r.slug}/`}>
          <span class="chip">Deep dive</span>
          <strong>{r.title}</strong>
          <span class="muted">{r.date}</span>
        </a>
      ))}
    </div>
  )}

  <a class="panel allcard" href="/stocks/">
    <strong>Browse all {(meta.universe_rows ?? meta.universe)?.toLocaleString?.() ?? ""} NYSE &amp; Nasdaq stocks →</strong>
    <span class="muted">Every listing with 1w–1y price moves, % off 52-week high, P/E, Sticker and buy price, and Big Five.
      Filter, sort and download as CSV.</span>
  </a>

  <ScreenView lists={lists} meta={meta} csvBase="/data/latest/" />
</Base>

<style>
  .lead { max-width: 860px; }
  .brief { margin-top: 14px; }
  .brief h2 { margin-top: 0; }
  .brief h3 { font-size: 15px; margin: 12px 0 4px; }
  .brief ul { margin: 6px 0; padding-left: 20px; }
  .brief li { margin: 4px 0; }
  .research { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 10px; margin-top: 16px; }
  .card { display: flex; flex-direction: column; gap: 4px; text-decoration: none; color: var(--ink); }
  .card:hover { border-color: var(--accent); }
  .card .chip { align-self: flex-start; }
  .allcard { display: flex; flex-direction: column; gap: 4px; margin-top: 10px; text-decoration: none; color: var(--ink);
    border-color: var(--accent); }
  .allcard:hover { background: var(--chip); }
</style>
