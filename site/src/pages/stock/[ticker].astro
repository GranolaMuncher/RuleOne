---
import Base from "../../layouts/Base.astro";
import PriceChart from "../../components/PriceChart.astro";
import { loadRun, loadUniverse, loadSnapshots, loadReports, loadMonthly, loadRadar, loadGurus, loadDossiers, loadInvestedIndex, loadStreet, MARKER_LABELS, STREET_LABEL, STREET_CLASS, type StreetRow, type PriceSeries, type Stock, type UniverseRow, type RadarItem, type GuruPos } from "../../lib/data";
import { usd, pct, big, mult, upside, flagClass, STATUS_LABEL, VERDICT_CLASS, RULERS_CLASS } from "../../lib/format";

export function getStaticPaths() {
  const { lists } = loadRun();
  const detailed = new Map(lists.all_candidates.map((s) => [s.ticker, s]));
  const snaps = loadSnapshots();
  const reports = loadReports();
  const universe = loadUniverse();
  const monthlyAll = loadMonthly();
  const radar = loadRadar().history;
  const gurus = loadGurus().by_ticker;
  const dossiers = new Map(loadDossiers().map((d) => [d.ticker, d]));
  const invested = loadInvestedIndex();
  const street = loadStreet();
  return universe.map((u) => ({
    params: { ticker: u.ticker },
    props: {
      u,
      monthly: monthlyAll.get(u.ticker),
      radar: radar[u.ticker] ?? [],
      gurus: gurus[u.ticker] ?? [],
      dossier: dossiers.get(u.ticker),
      street: street.get(u.ticker),
      episodes: (invested[u.ticker]?.episodes ?? []).slice(0, 8),
      detail: detailed.get(u.ticker),
      snaps: snaps.get(u.ticker) ?? [],
      reports: reports.filter((r) => r.kind !== "model" && r.body.includes(u.ticker) &&
        new RegExp(`\\b${u.ticker.replace(/[-.]/g, "\\$&")}\\b`).test(r.body)),
      model: reports.find((r) => r.slug === `model/${u.ticker}`),
    },
  }));
}
const { u, monthly, detail, snaps, reports, model, radar, gurus, dossier, episodes, street } = Astro.props as {
  street?: StreetRow;
  episodes: { id: string; title: string; mentions: number; sentence: string }[];
  u: UniverseRow; monthly?: PriceSeries; detail?: Stock; radar: RadarItem[]; gurus: GuruPos[];
  dossier?: { verdict: string; confidence: number | null; entry: number[]; trim: number | null; updated: string; summary: string };
  snaps: { date: string; price: number | null; sticker: number | null; mos: number | null; status: string }[];
  reports: { slug: string; title: string; date: string }[]; model?: { slug: string };
};

const levels = [
  ["Buy (MOS)", u.mos, "50% of Sticker"],
  ["Ten Cap", u.tenCap, "10× owner earnings − net debt"],
  ["Payback Time", u.payback, "8-year FCF payback"],
  ["Sticker", u.sticker, "Rule #1 intrinsic value"],
] as const;

// Price ladder: today's price against the Rule #1 levels.
const pts = [u.price, ...levels.map((l) => l[1])].filter((v): v is number => v != null && v > 0);
const lo = pts.length ? Math.min(...pts) * 0.9 : 0, hi = pts.length ? Math.max(...pts) * 1.05 : 1;
const x = (v: number) => ((v - lo) / (hi - lo || 1)) * 100;



// Analyst consensus on its own scale: the street's low–high band against the price and the Rule #1 levels.
const sPts = street ? [street.low, street.high, street.mean, u.price, u.mos, u.sticker].filter((v): v is number => v != null && v > 0) : [];
const sLo = sPts.length ? Math.min(...sPts) * 0.92 : 0, sHi = sPts.length ? Math.max(...sPts) * 1.04 : 1;
const sx = (v: number) => ((v - sLo) / (sHi - sLo || 1)) * 100;
const sMarks = ([["Buy (MOS)", u.mos], ["Sticker", u.sticker]] as [string, number | null][]).filter(([, v]) => v != null && v > 0);
const sTotal = street ? street.counts.reduce((a, c) => a + c.n, 0) : 0;
const STREET_TEXT: Record<string, string> = {
  agree: "Rule #1 price and the street both say cheap.",
  contrarian: "Rule #1 price says cheap but analysts are cautious. Find out what they fear: it may be the event, or a story change.",
  crowded: "Analysts love it but the price is above Sticker. Good news is already priced in.",
  "both cautious": "Above Sticker, and the street is cautious too.",
  "thin coverage": "Fewer than 3 analysts cover it: more room for mispricing, less help checking the numbers.",
  mixed: "",
};

const changes = [["1 week", u.chg.w1], ["1 month", u.chg.m1], ["3 months", u.chg.m3], ["6 months", u.chg.m6], ["YTD", u.chg.ytd], ["1 year", u.chg.y1]] as const;
const statusClass = u.status.replace("*", "star").replace(/\s/g, "");
---
<Base title={`${u.ticker} · ${u.name}`} description={`${u.name}: price ${usd(u.price)}, Rule #1 Sticker ${usd(u.sticker)}, buy price ${usd(u.mos)}.`}>
  <p><a href="/stocks/">← All stocks</a></p>
  <div class="head">
    <div>
      <h1>{u.ticker} <span class="muted name">{u.name}</span></h1>
      <p class="muted">{u.exchange}{u.sector && <> · <a href={`/stocks/#sector=${encodeURIComponent(u.sector)}`}>{u.sector}</a></>}{u.industry && <> · <a href={`/stocks/#sector=${encodeURIComponent(u.sector)}&industry=${encodeURIComponent(u.industry)}`}>{u.industry}</a></>} · Market cap {big(u.marketCap)} · {usd(u.price)} on {u.priceDate || "–"}</p>
    </div>
    <div class="badges">
      <span class={`chip ${statusClass}`}>{STATUS_LABEL[u.status] ?? u.status}</span>
      {u.tier && <span class={`chip tier ${u.tier}`}>Tier {u.tier}</span>}
      <span class="chip" title={u.detail === "ttm" ? "Passed the quality screen: detailed TTM, currency-adjusted analysis" : "Screened on last fiscal-year SEC data"}>
        {u.detail === "ttm" ? "Detailed (TTM)" : `Fiscal-year data${u.epsBasis ? ` · ${u.epsBasis}` : ""}`}
      </span>
    </div>
  </div>
  {dossier && (
    <section class="panel dossier">
      <span class={`chip ${RULERS_CLASS[dossier.verdict] ?? ""}`}>RULERS: {dossier.verdict}</span>
      <span class="muted small"> confidence {dossier.confidence ?? "–"}/5 · tranches {dossier.entry.map((e) => usd(e)).join(" / ") || "–"} · trim {usd(dossier.trim)} · {dossier.updated}</span>
      <p>{dossier.summary} <a href={`/rulers/${u.ticker}/`}>Read the dossier →</a></p>
    </section>
  )}
  {u.flags && <p>{u.flags.split(";").filter(Boolean).map((f) => <span class={`chip ${flagClass(f)}`}>{f}</span>)}</p>}

  <section class="panel">
    <h2>Price moves</h2>
    <div class="changes">
      {changes.map(([label, v]) => (
        <div><span class="muted">{label}</span><b class={v == null ? "" : v >= 0 ? "pos" : "neg"}>{pct(v)}</b></div>
      ))}
      <div><span class="muted">Off 52w high</span><b class={(u.offHigh ?? 0) < 0 ? "neg" : ""}>{pct(u.offHigh)}</b></div>
      <div><span class="muted">52w range</span><b>{usd(u.low52, 0)}–{usd(u.high52, 0)}</b></div>
    </div>
  </section>

  <PriceChart ticker={u.ticker} monthly={monthly} weekly={u.spark} liveDate={u.priceDate} mos={u.mos} sticker={u.sticker} />

  {pts.length > 1 && (
    <section class="panel ladder" aria-label="Price versus Rule #1 levels">
      <div class="track">
        {[...levels].filter(([, v]) => v != null && v > 0).sort((a, b) => a[1]! - b[1]!).map(([label, v], i) => (
          <div class={`mark ${i % 2 ? "low" : ""}`} style={`left:${x(v!)}%`}><span class="tick"></span><span class="lbl">{label}<br /><b>{usd(v, 0)}</b></span></div>
        ))}
        {u.price && <div class="price" style={`left:${x(u.price)}%`}><span class="lbl">Price<br /><b>{usd(u.price, 0)}</b></span></div>}
      </div>
    </section>
  )}

  {street && street.mean != null && (
    <section class="panel">
      <h2>Analyst consensus <span class="muted">{street.n ?? "?"} analysts · as of {street.asOf} · <a href="/street/">the street vs Rule #1</a></span></h2>
      <p>
        {street.signal && STREET_LABEL[street.signal] && <span class={`chip ${STREET_CLASS[street.signal] ?? ""}`}>{STREET_LABEL[street.signal]}</span>}{" "}
        Targets <b>{usd(street.low, 0)}</b> low · <b>{usd(street.mean, 0)}</b> mean · <b>{usd(street.high, 0)}</b> high
        {street.upside != null && <> (<span class={street.upside >= 0 ? "pos" : "neg"}>{street.upside >= 0 ? "+" : ""}{pct(street.upside)}</span> to the mean)</>}
        {street.revision != null && <> · mean target {street.revision >= 0 ? "up" : "down"} {pct(Math.abs(street.revision))} in 30 days</>}
      </p>
      {STREET_TEXT[street.signal] && <p class="muted small">{STREET_TEXT[street.signal]}</p>}
      {sPts.length > 1 && street.low != null && street.high != null && (
        <div class="ladder street" aria-label="Analyst target range versus price and Rule #1 levels">
          <div class="track">
            <div class="band" style={`left:${sx(street.low)}%;width:${sx(street.high) - sx(street.low)}%`}></div>
            <div class="mark" style={`left:${sx(street.low)}%`}><span class="tick"></span><span class="lbl">Low<br /><b>{usd(street.low, 0)}</b></span></div>
            {street.mean != null && <div class="mark mean" style={`left:${sx(street.mean)}%`}><span class="tick"></span><span class="lbl">Mean<br /><b>{usd(street.mean, 0)}</b></span></div>}
            <div class="mark" style={`left:${sx(street.high)}%`}><span class="tick"></span><span class="lbl">High<br /><b>{usd(street.high, 0)}</b></span></div>
            {sMarks.map(([label, v]) => (
              <div class="mark low r1" style={`left:${sx(v!)}%`}><span class="tick"></span><span class="lbl">{label}<br /><b>{usd(v, 0)}</b></span></div>
            ))}
            {u.price && <div class="price" style={`left:${sx(u.price)}%`}><span class="lbl">Price<br /><b>{usd(u.price, 0)}</b></span></div>}
          </div>
        </div>
      )}
      {sTotal > 0 && (
        <div class="ratings" aria-label="Analyst ratings">
          {street.counts.filter((c) => c.n > 0).map((c, i) => (
            <span class={`r r${street.counts.indexOf(c)}`} style={`flex:${c.n}`} title={`${c.label}: ${c.n}`}>{c.label} {c.n}</span>
          ))}
        </div>
      )}
      <p class="muted small">
        Average rating {street.rec != null ? `${street.rec.toFixed(1)} of 5` : "–"} (1 = strong buy, 5 = sell){street.recKey && ` · ${street.recKey.replace("_", " ")}`}
        {street.epsGrowthNy != null && <> · EPS growth next year {pct(street.epsGrowthNy)} vs windage {pct(u.growth, 1)}</>}
      </p>
      {street.actions.length > 0 && <ul class="eps small">{street.actions.map((a) => <li>{a}</li>)}</ul>}
      <p class="muted small">A price target is a 12-month price opinion, not a valuation. Rule #1 treats analysts as a lead and their growth as a ceiling (<a href="/learn/077/">077</a>, <a href="/learn/093/">093</a>). Source: Yahoo Finance consensus.</p>
    </section>
  )}

  <div class="grid">
    <section class="panel">
      <h2>Valuation</h2>
      <table class="kv">
        {levels.map(([label, v, note]) => (
          <tr><th>{label} <span class="muted">{note}</span></th><td class="num">{usd(v)}</td>
            <td class={`num ${(upside(u.price, v) ?? 0) >= 0 ? "pos" : "neg"}`}>{pct(upside(u.price, v))}</td></tr>
        ))}
        <tr><th>Methods agree <span class="muted">price under how many of Ten Cap, Payback, MOS</span></th>
          <td class="num"><b class={u.methodsAgree >= 2 ? "pos" : ""}>{u.methodsAgree} of 3</b></td><td></td></tr>
        <tr><th>Windage growth g</th><td class="num">{pct(u.growth, 1)}</td><td></td></tr>
        {detail?.futurePe != null && <tr><th>Future P/E (min 2g, 10y median)</th><td class="num">{mult(detail.futurePe)}</td><td></td></tr>}
        <tr><th>P/E · 10y median</th><td class="num">{mult(u.pe)}</td><td class="num">{mult(u.histPe)}</td></tr>
        <tr><th>EPS <span class="muted">{u.epsBasis}</span></th><td class="num">{usd(u.eps)}</td><td></td></tr>
        <tr><th>FCF yield</th><td class="num">{pct(u.fcfYield, 1)}</td><td></td></tr>
        <tr><th>Dividend (TTM) · yield</th><td class="num">{usd(u.divTtm)}</td><td class="num">{pct(u.divYield, 1)}</td></tr>
        {u.divGrowth5y != null && <tr><th>Dividend growth <span class="muted">5y, per year</span></th><td class="num">{pct(u.divGrowth5y, 1)}</td><td></td></tr>}
        <tr><th>Total return <span class="muted">per year, dividends reinvested · 5y · 10y</span></th><td class="num">{pct(u.tr5y, 1)}</td><td class="num">{pct(u.tr10y, 1)}</td></tr>
        <tr><th>Revenue · net income <span class="muted">last FY</span></th><td class="num">{big(u.revenue)}</td><td class="num">{big(u.netIncome)}</td></tr>
      </table>
    </section>
    <section class="panel">
      <h2>Big Five <span class="muted">{u.big5Tests ? `${u.big5Tests} tests ≥10%` : "not enough history"}</span></h2>
      <table class="kv b5">
        <tr><th></th><th class="num">10y</th><th class="num">5y</th><th class="num">1y</th></tr>
        <tr><th>ROIC</th>{u.roic.map((v) => <td class={`num ${v == null ? "" : v >= 0.1 ? "pos" : "neg"}`}>{pct(v)}</td>)}</tr>
        {Object.entries(u.growthTable).map(([k, vals]) => (
          <tr><th>{k} growth</th>{vals.map((v) => <td class={`num ${v == null ? "" : v >= 0.1 ? "pos" : "neg"}`}>{pct(v)}</td>)}</tr>
        ))}
        <tr><th>Debt payoff (yrs of FCF)</th><td class="num">{u.debtPayoff == null ? "–" : u.debtPayoff.toFixed(1)}</td><td></td><td></td></tr>
      </table>
      {!u.big5Tests && <p class="muted small">Big Five needs several years of SEC XBRL data. Recent IPOs, foreign IFRS filers and funds have little or none.</p>}
    </section>
  </div>

  <section class="panel">
    <h2>Events</h2>
    <p>{u.events || (u.detail === "ttm" ? "No notable events detected." : "Event scan (8-Ks, insider buys, 13Ds) runs for stocks that pass the quality screen.")}</p>
    <p class="muted">
      {detail?.nextReport && <>Next report ≈ {detail.nextReport} · </>}
      <a href={`https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=${encodeURIComponent(u.ticker)}&type=&dateb=&owner=include&count=40`} rel="noopener">SEC filings</a> ·
      <a href={`https://finance.yahoo.com/quote/${encodeURIComponent(u.ticker)}`} rel="noopener">Yahoo Finance</a>
    </p>
  </section>

  {(u.markers.length > 0 || episodes.length > 0) && (
    <div class="grid">
      {u.markers.length > 0 && (
        <section class="panel">
          <h2>Wonderful-business markers <span class="muted">{u.markerScore != null ? `${Math.round(u.markerScore * 100)}% of known markers passed` : ""} · <a href="/rule1/#markers">what these mean</a></span></h2>
          <ul class="markers">
            {u.markers.map((m) => (
              <li class={m.pass === true ? "pos" : m.pass === false ? "neg" : "muted"}>
                <span aria-hidden="true">{m.pass === true ? "✔" : m.pass === false ? "✘" : "?"}</span> {MARKER_LABELS[m.key] ?? m.key}
                <span class="sr">{m.pass === true ? "passed" : m.pass === false ? "failed" : "not enough data"}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
      {episodes.length > 0 && (
        <section class="panel">
          <h2>Discussed on InvestED <span class="muted">{episodes.length} episode{episodes.length > 1 ? "s" : ""}</span></h2>
          <ul class="eps">
            {episodes.map((e) => <li><a href={`/learn/${e.id}/`}>{e.id} · {e.title}</a><div class="muted small">{e.sentence}</div></li>)}
          </ul>
        </section>
      )}
    </div>
  )}

  {(radar.length > 0 || gurus.length > 0) && (
    <section class="panel">
      <h2>Radar <span class="muted">news and filings, judged against the <a href="/rule1/#method">event rules</a></span></h2>
      {radar.length > 0 && (
        <ul class="radar">
          {radar.map((it) => (
            <li><span class={`chip ${VERDICT_CLASS[it.verdict] ?? ""}`}>{it.verdict}</span> <span class="muted">{it.date}</span> · {it.headline}
              <div class="muted small">{it.why} {it.sources?.map((s, i) => <a href={s} rel="noopener">[{i + 1}]</a>)}</div></li>
          ))}
        </ul>
      )}
      {gurus.length > 0 && (
        <p class="small">Held by: {gurus.map((g, i) => <>{i ? " · " : ""}<b>{g.guru}</b> {pct(g.weight, 1)} of 13F{g.change !== "held" ? ` (${g.change})` : ""}</>)}
          <span class="muted"> as of {gurus[0].report}. 13Fs lag up to 45 days and show names, not decisions.</span></p>
      )}
    </section>
  )}

  {snaps.length > 1 && (
    <section class="panel">
      <h2>Across screen runs</h2>
      <table class="kv">
        <tr><th>Run</th><th class="num">Price</th><th class="num">Sticker</th><th class="num">Buy (MOS)</th><th>Status</th></tr>
        {[...snaps].reverse().map((s) => (
          <tr><td>{s.date}</td><td class="num">{usd(s.price)}</td><td class="num">{usd(s.sticker)}</td><td class="num">{usd(s.mos)}</td><td>{s.status}</td></tr>
        ))}
      </table>
    </section>
  )}

  {(reports.length > 0 || model) && (
    <section class="panel">
      <h2>Research</h2>
      <ul>
        {model && <li><a href={`/reports/${model.slug}/`}>Valuation model output</a></li>}
        {reports.map((r) => <li><a href={`/reports/${r.slug}/`}>{r.title}</a> <span class="muted">{r.date}</span></li>)}
      </ul>
    </section>
  )}
</Base>

<style>
  .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
  .name { font-weight: 500; font-size: 18px; }
  .badges { display: flex; gap: 6px; flex-wrap: wrap; }
  .chip.warn, .chip.info { margin-right: 6px; }
  section.panel { margin-top: 14px; }
  section.panel h2 { margin-top: 0; font-size: 16px; }
  .small { font-size: 12.5px; }
  .dossier p { margin: 6px 0 0; }
  .markers, .eps { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; font-size: 14px; }
  .markers li { color: var(--ink); } .markers li.pos span, .markers li.neg span { font-weight: 700; }
  .markers li.pos span { color: var(--buy); } .markers li.neg span { color: var(--warn); }
  .eps li { margin-bottom: 4px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .radar { list-style: none; padding: 0; margin: 0 0 8px; display: grid; gap: 8px; }
  .changes { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 8px; margin-bottom: 10px; }
  .changes div { display: flex; flex-direction: column; font-size: 12.5px; }
  .changes b { font-size: 16px; font-variant-numeric: tabular-nums; }
  .legend { font-size: 12.5px; color: var(--muted); }
  .k { display: inline-block; width: 14px; height: 3px; margin: 0 4px 3px 10px; vertical-align: middle; }
  .k.px { background: var(--accent); } .k.st { background: var(--deck); } .k.mos { background: var(--buy); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 14px; }
  .kv { width: 100%; border-collapse: collapse; font-size: 14px; }
  .kv th, .kv td { padding: 6px 4px; border-bottom: 1px solid var(--line); text-align: left; font-weight: 500; }
  .kv th .muted { font-weight: 400; font-size: 12px; }
  .kv td.num, .kv th.num { text-align: right; }
  .ladder { padding: 56px 20px 90px; overflow: hidden; }
  .track { position: relative; height: 4px; background: var(--line); border-radius: 2px; margin: 0 40px; }
  .mark, .price { position: absolute; top: 0; transform: translateX(-50%); }
  .tick { display: block; width: 2px; height: 14px; margin-top: -5px; background: var(--muted); }
  .mark.low .tick { height: 40px; }
  .mark .lbl { position: absolute; top: 14px; left: 50%; transform: translateX(-50%); font-size: 11.5px; color: var(--muted); text-align: center; white-space: nowrap; }
  .mark.low .lbl { top: 40px; }
  .price::before { content: ""; display: block; width: 14px; height: 14px; margin-top: -5px; border-radius: 50%; background: var(--accent); }
  .price .lbl { position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%); font-size: 12px; text-align: center; white-space: nowrap; color: var(--accent); }
  .ladder.street { padding: 48px 8px 80px; }
  .band { position: absolute; top: -4px; height: 12px; background: color-mix(in srgb, var(--accent) 22%, transparent); border-radius: 6px; }
  .mark.mean .tick { background: var(--ink); height: 18px; margin-top: -7px; }
  .mark.r1 .tick { background: var(--buy); }
  .ratings { display: flex; gap: 2px; margin: 8px 0; font-size: 11.5px; border-radius: 6px; overflow: hidden; }
  .ratings .r { padding: 4px 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #fff; min-width: 0; }
  .r0 { background: #1f7a4a; } .r1 { background: #4c9a6a; } .r2 { background: #8a8f98; } .r3 { background: #c0703a; } .r4 { background: #a8322d; }
</style>
