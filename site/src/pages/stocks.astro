---
import Base from "../layouts/Base.astro";
import { loadRun, loadUniverse } from "../lib/data";

const { meta } = loadRun();
const total = loadUniverse().length;
---
<Base title="All stocks" description="Every NYSE and Nasdaq stock with price moves, Rule #1 Sticker Price, buy price and Big Five, filterable.">
  <h1>All stocks</h1>
  <p class="muted lead">
    All {total.toLocaleString()} NYSE &amp; Nasdaq listings, prices as of {meta.price_date ?? "–"}. Price moves come from
    Yahoo. Financials come from SEC filings, using the <b>last fiscal year</b>, except names marked
    <span class="chip ttm">TTM</span>, which passed the quality screen and got the detailed trailing-twelve-month,
    currency-adjusted analysis. Sticker Prices use history-based growth with no analyst haircut, so treat them as upper bounds.
  </p>

  <div class="presets" role="group" aria-label="Presets">
    <button data-preset="drops">Big drops (≥30% off high)</button>
    <button data-preset="qualitydrops">Quality on sale (Big 5 ≥60%, ≥20% off high, ≥$300M)</button>
    <button data-preset="below">Below Sticker</button>
    <button data-preset="buy">In buy range (quality)</button>
    <button data-preset="wonderful">Tier A</button>
    <button data-preset="reset" class="ghost">Reset</button>
  </div>

  <form class="filters panel" id="filters" onsubmit="return false">
    <label class="grow">Search<input type="search" name="q" placeholder="Ticker, name or industry…" /></label>
    <label>Exchange
      <select name="ex"><option value="">All</option><option>NYSE</option><option>Nasdaq</option></select>
    </label>
    <label>Sector
      <select name="sector"><option value="">All sectors</option></select>
    </label>
    <label class="wide">Industry
      <select name="industry"><option value="">All industries</option></select>
    </label>
    <label>Status
      <select name="status">
        <option value="">Any</option><option value="BUY">Buy range</option><option value="BUY*">Buy (Payback/Ten Cap)</option>
        <option value="ON DECK">On deck</option><option value="below">Below Sticker (any)</option>
        <option value="BELOW MOS">Below buy price, not quality</option><option value="BELOW STICKER">Below Sticker, not quality</option>
        <option value="ABOVE STICKER">Above Sticker</option><option value="NO STICKER">No Sticker</option>
      </select>
    </label>
    <label>Tier
      <select name="tier"><option value="">Any</option><option value="A">A</option><option value="AB">A or B</option><option value="ABC">A, B or C</option></select>
    </label>
    <label>% off 52w high ≥
      <select name="off"><option value="">Any</option><option>10</option><option>20</option><option>30</option><option>40</option><option>50</option><option>70</option></select>
    </label>
    <label>1-month change ≤
      <select name="m1"><option value="">Any</option><option value="-5">−5%</option><option value="-10">−10%</option><option value="-20">−20%</option><option value="-30">−30%</option></select>
    </label>
    <label>Big 5 ≥
      <select name="b5"><option value="">Any</option><option value="0.4">40%</option><option value="0.6">60%</option><option value="0.8">80%</option></select>
    </label>
    <label>Div yield ≥
      <select name="dy"><option value="">Any</option><option value="0.0001">Pays dividend</option><option value="0.01">1%</option><option value="0.02">2%</option><option value="0.03">3%</option><option value="0.04">4%</option><option value="0.05">5%</option></select>
    </label>
    <label>Max P/E<input type="number" name="pe" min="0" step="1" placeholder="any" /></label>
    <label>Max Price/Sticker<input type="number" name="pts" min="0" step="0.1" placeholder="any" /></label>
    <label>Market cap ≥
      <select name="mcap"><option value="">Any</option><option value="3e8">$300M</option><option value="1e9">$1B</option><option value="1e10">$10B</option><option value="1e11">$100B</option></select>
    </label>
    <label class="check"><input type="checkbox" name="hasSticker" /> Has Sticker</label>
    <label class="check"><input type="checkbox" name="hideFlagged" /> Hide flagged</label>
  </form>

  <div class="bar">
    <span id="count" class="muted">Loading…</span>
    <span class="spacer"></span>
    <button id="csv" type="button">Download CSV</button>
  </div>

  <div class="tablewrap">
    <table id="all">
      <thead>
        <tr>
          <th data-k="ticker">Ticker</th>
          <th data-k="sector">Sector</th>
          <th data-k="status">Status</th>
          <th data-k="tier">Tier</th>
          <th class="num" data-k="price">Price</th>
          <th class="num" data-k="w1">1w</th>
          <th class="num" data-k="m1">1m</th>
          <th class="num" data-k="m3">3m</th>
          <th class="num" data-k="ytd">YTD</th>
          <th class="num" data-k="y1">1y</th>
          <th class="num" data-k="offHigh" title="% below 52-week high">Off high</th>
          <th class="num" data-k="pe">P/E</th>
          <th class="num" data-k="mos" title="Margin-of-safety buy price = 50% of Sticker">Buy (MOS)</th>
          <th class="num" data-k="sticker">Sticker</th>
          <th class="num" data-k="pts" title="Price ÷ Sticker">P/Stk</th>
          <th class="num" data-k="tenCap">Ten Cap</th>
          <th class="num" data-k="divYield" title="Trailing 12-month dividends ÷ price">Div yield</th>
          <th class="num" data-k="tr10y" title="10-year total return per year, dividends reinvested">TR 10y/yr</th>
          <th class="num" data-k="roic5">ROIC 5y</th>
          <th class="num" data-k="big5">Big 5</th>
          <th class="num" data-k="marketCap">Mkt cap</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
  <div class="pager">
    <button id="prev" type="button">← Prev</button>
    <span id="page" class="muted"></span>
    <button id="next" type="button">Next →</button>
  </div>
</Base>

<style>
  .lead { max-width: 900px; font-size: 14px; }
  .chip.ttm { background: var(--deck-bg); color: var(--deck); }
  .presets { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0; }
  button { font: inherit; font-size: 13.5px; padding: 6px 12px; border-radius: 8px; border: 1px solid var(--line);
    background: var(--panel); color: var(--ink); cursor: pointer; }
  button:hover { border-color: var(--accent); }
  button.active { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  button.ghost { color: var(--muted); }
  button:disabled { opacity: .4; cursor: default; }
  .filters { display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: flex-end; padding: 12px 14px; }
  .filters label { display: flex; flex-direction: column; gap: 3px; font-size: 12px; color: var(--muted); }
  .filters label.grow { flex: 1 1 200px; }
  .filters label.wide select { max-width: 280px; }
  .filters label.check { flex-direction: row; align-items: center; gap: 6px; font-size: 13px; padding-bottom: 6px; }
  input, select { font: inherit; font-size: 14px; padding: 6px 8px; border-radius: 8px; border: 1px solid var(--line);
    background: var(--bg); color: var(--ink); min-width: 0; }
  input[type="number"] { width: 96px; }
  .bar { display: flex; align-items: center; gap: 10px; margin: 14px 0 8px; }
  .spacer { flex: 1; }
  .tablewrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); }
  .pager { display: flex; justify-content: center; align-items: center; gap: 12px; margin: 14px 0; }
</style>

<style is:global>
  /* rows are rendered by script, so these can't be component-scoped */
  #all { border-collapse: collapse; width: 100%; font-size: 13.5px; }
  #all th, #all td { padding: 7px 9px; border-bottom: 1px solid var(--line); vertical-align: top; white-space: nowrap; }
  #all th { position: sticky; top: 0; background: var(--panel); text-align: left; font-size: 12px; color: var(--muted);
    font-weight: 600; cursor: pointer; user-select: none; }
  #all th.num, #all td.num { text-align: right; font-variant-numeric: tabular-nums; }
  #all th[aria-sort="ascending"]::after { content: " ▲"; } #all th[aria-sort="descending"]::after { content: " ▼"; }
  #all tbody tr:hover { background: var(--chip); }
  #all .tk { font-weight: 700; text-decoration: none; }
  #all .nm { color: var(--muted); font-size: 12px; max-width: 210px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #all .mini { font-size: 10.5px; vertical-align: 1px; margin-left: 4px; padding: 0 5px; }
  #all .ttm { background: var(--deck-bg); color: var(--deck); }
  #all .pos { color: var(--buy); } #all .neg { color: var(--warn); }
  #all .flag { color: var(--warn); margin-left: 3px; cursor: help; }
</style>

<script>
  type Row = Record<string, any>;
  const PAGE = 100;
  const fmtUsd = (v: number | null, d = 2) =>
    v == null ? "–" : "$" + v.toLocaleString("en-US", { minimumFractionDigits: d, maximumFractionDigits: d });
  const fmtPct = (v: number | null) => (v == null ? "–" : `${v > 0 ? "+" : ""}${(v * 100).toFixed(0)}%`);
  const fmtBig = (v: number | null) =>
    v == null ? "–" : v >= 1e12 ? `$${(v / 1e12).toFixed(2)}T` : v >= 1e9 ? `$${(v / 1e9).toFixed(1)}B` : `$${(v / 1e6).toFixed(0)}M`;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const STATUS: Record<string, string> = { BUY: "BUY", "BUY*": "BUYstar", "ON DECK": "ONDECK" };
  const SHORT: Record<string, string> = { "Information Technology": "Tech", "Consumer Discretionary": "Cons. disc.",
    "Consumer Staples": "Cons. staples", "Communication Services": "Comm. services", "Health Care": "Health care" };
  const LABEL: Record<string, string> = { "BELOW MOS": "below MOS", "BELOW STICKER": "below sticker", "ABOVE STICKER": "above sticker", "NO STICKER": "–", "NO PRICE": "–" };

  const form = document.getElementById("filters") as HTMLFormElement;
  const tbody = document.querySelector("#all tbody") as HTMLTableSectionElement;
  const countEl = document.getElementById("count")!;
  let rows: Row[] = [];
  let view: Row[] = [];
  let page = 0;
  let sortKey = "marketCap";
  let sortAsc = false;

  const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null);
  const get = (n: string) => { const el = val(n); return el ? (el.type === "checkbox" ? (el.checked ? "1" : "") : el.value) : ""; };
  const set = (n: string, v: string) => { const el = val(n); if (!el) return; if (el.type === "checkbox") el.checked = !!v; else el.value = v; };
  const FIELDS = ["q", "ex", "sector", "industry", "status", "tier", "off", "m1", "b5", "dy", "pe", "pts", "mcap", "hasSticker", "hideFlagged"];

  function filterRows() {
    const q = get("q").trim().toLowerCase();
    const ex = get("ex"), status = get("status"), tier = get("tier");
    const sector = get("sector"), industry = get("industry");
    const off = get("off") ? -Number(get("off")) / 100 : null;
    const m1 = get("m1") ? Number(get("m1")) / 100 : null;
    const b5 = get("b5") ? Number(get("b5")) : null;
    const pe = get("pe") ? Number(get("pe")) : null;
    const dy = get("dy") ? Number(get("dy")) : null;
    const pts = get("pts") ? Number(get("pts")) : null;
    const mcap = get("mcap") ? Number(get("mcap")) : null;
    const hasSticker = !!get("hasSticker"), hideFlagged = !!get("hideFlagged");
    const minTests = b5 != null ? 8 : 0;   // a Big 5 % on 3 or 4 tests is noise
    view = rows.filter((r) => {
      if (q && !(r.ticker.toLowerCase().includes(q) || (r.name || "").toLowerCase().includes(q) ||
        (r.industry || "").toLowerCase().includes(q))) return false;
      if (ex && r.exchange !== ex) return false;
      if (sector && r.sector !== sector) return false;
      if (industry && r.industry !== industry) return false;
      if (status === "below") { if (!(r.pts != null && r.pts <= 1)) return false; }
      else if (status && r.status !== status) return false;
      if (tier && !(r.tier && tier.includes(r.tier))) return false;
      if (off != null && !(r.offHigh != null && r.offHigh <= off)) return false;
      if (m1 != null && !(r.m1 != null && r.m1 <= m1)) return false;
      if (b5 != null && !(r.big5 != null && r.big5 >= b5 && testsTotal(r) >= minTests)) return false;
      if (pe != null && !(r.pe != null && r.pe > 0 && r.pe <= pe)) return false;
      if (dy != null && !(r.divYield != null && r.divYield >= dy)) return false;
      if (pts != null && !(r.pts != null && r.pts <= pts)) return false;
      if (mcap != null && !(r.marketCap != null && r.marketCap >= mcap)) return false;
      if (hasSticker && r.sticker == null) return false;
      if (hideFlagged && /check|micro-cap|non-US/.test(r.flags || "")) return false;
      return true;
    });
    sortRows();
  }

  // Sector / industry dropdowns are built from the data, with counts; industries follow the sector.
  function fillSelect(name: string, values: Map<string, number>, allLabel: string) {
    const el = val(name) as unknown as HTMLSelectElement;
    const keep = el.value;
    const opts = [...values.entries()].sort((a, b) => a[0].localeCompare(b[0]));
    el.innerHTML = `<option value="">${allLabel}</option>` +
      opts.map(([v, n]) => `<option value="${esc(v)}">${esc(v)} (${n})</option>`).join("");
    el.value = opts.some(([v]) => v === keep) ? keep : "";
  }
  function refreshOptions() {
    const count = (key: string, pick: (r: Row) => boolean) => {
      const m = new Map<string, number>();
      for (const r of rows) if (r[key] && pick(r)) m.set(r[key], (m.get(r[key]) ?? 0) + 1);
      return m;
    };
    fillSelect("sector", count("sector", () => true), "All sectors");
    const sector = get("sector");
    fillSelect("industry", count("industry", (r) => !sector || r.sector === sector), "All industries");
  }

  const testsTotal = (r: Row) => Number(String(r.big5Tests || "0/0").split("/")[1]) || 0;

  function sortRows() {
    const k = sortKey, dir = sortAsc ? 1 : -1;
    view.sort((a, b) => {
      const va = a[k], vb = b[k];
      if (va == null && vb == null) return 0;
      if (va == null || va === "") return 1;
      if (vb == null || vb === "") return -1;
      return (typeof va === "string" ? va.localeCompare(vb) : va - vb) * dir;
    });
    const q = get("q").trim().toUpperCase();   // exact ticker match first when searching
    if (q) view.sort((a, b) => Number(b.ticker === q) - Number(a.ticker === q));
    page = 0;
    render();
  }

  function cls(v: number | null) { return v == null ? "" : v >= 0 ? "pos" : "neg"; }

  function render() {
    const start = page * PAGE;
    const slice = view.slice(start, start + PAGE);
    tbody.innerHTML = slice.map((r) => {
      const flagged = r.flags ? `<span class="flag" title="${esc(r.flags.replace(/;/g, " · "))}">⚠</span>` : "";
      const ttm = r.detail === "ttm" ? `<span class="chip ttm mini" title="Detailed TTM analysis">TTM</span>` : "";
      return `<tr>
        <td><a class="tk" href="/stock/${encodeURIComponent(r.ticker)}/">${esc(r.ticker)}</a>${ttm}${flagged}<div class="nm">${esc(r.name || "")}</div></td>
        <td title="${esc(r.industry || "")}">${esc(SHORT[r.sector] ?? r.sector ?? "") || "–"}<div class="nm">${esc(r.industry || "")}</div></td>
        <td>${r.status && STATUS[r.status] ? `<span class="chip ${STATUS[r.status]}">${esc(r.status)}</span>` : `<span class="muted">${esc(LABEL[r.status] ?? (r.status || "").toLowerCase())}</span>`}</td>
        <td><span class="tier ${r.tier}">${r.tier || "–"}</span></td>
        <td class="num">${fmtUsd(r.price)}</td>
        <td class="num ${cls(r.w1)}">${fmtPct(r.w1)}</td>
        <td class="num ${cls(r.m1)}">${fmtPct(r.m1)}</td>
        <td class="num ${cls(r.m3)}">${fmtPct(r.m3)}</td>
        <td class="num ${cls(r.ytd)}">${fmtPct(r.ytd)}</td>
        <td class="num ${cls(r.y1)}">${fmtPct(r.y1)}</td>
        <td class="num ${cls(r.offHigh)}">${fmtPct(r.offHigh)}</td>
        <td class="num">${r.pe == null ? "–" : r.pe.toFixed(1)}</td>
        <td class="num"><strong>${fmtUsd(r.mos)}</strong></td>
        <td class="num">${fmtUsd(r.sticker)}</td>
        <td class="num">${r.pts == null ? "–" : r.pts.toFixed(2)}</td>
        <td class="num">${fmtUsd(r.tenCap)}</td>
        <td class="num">${r.divYield == null ? "–" : (r.divYield * 100).toFixed(1) + "%"}</td>
        <td class="num ${cls(r.tr10y)}">${r.tr10y == null ? "–" : (r.tr10y * 100).toFixed(1) + "%"}</td>
        <td class="num">${r.roic5 == null ? "–" : (r.roic5 * 100).toFixed(0) + "%"}</td>
        <td class="num">${esc(r.big5Tests || "–")}</td>
        <td class="num">${fmtBig(r.marketCap)}</td>
      </tr>`;
    }).join("");
    const pages = Math.max(1, Math.ceil(view.length / PAGE));
    countEl.textContent = `${view.length.toLocaleString()} of ${rows.length.toLocaleString()} stocks`;
    document.getElementById("page")!.textContent = `Page ${page + 1} of ${pages}`;
    (document.getElementById("prev") as HTMLButtonElement).disabled = page === 0;
    (document.getElementById("next") as HTMLButtonElement).disabled = page >= pages - 1;
    document.querySelectorAll<HTMLTableCellElement>("#all th").forEach((th) =>
      th.dataset.k === sortKey ? th.setAttribute("aria-sort", sortAsc ? "ascending" : "descending") : th.removeAttribute("aria-sort"));
    saveState();
  }

  function saveState() {
    const p = new URLSearchParams();
    for (const f of FIELDS) { const v = get(f); if (v) p.set(f, v); }
    if (sortKey !== "marketCap" || sortAsc) p.set("sort", `${sortKey}:${sortAsc ? "asc" : "desc"}`);
    if (page) p.set("page", String(page + 1));
    history.replaceState(null, "", p.toString() ? `#${p}` : location.pathname);
  }

  function loadState() {
    const p = new URLSearchParams(location.hash.slice(1));
    for (const f of FIELDS) set(f, p.get(f) ?? "");
    const s = p.get("sort");
    if (s) { const [k, d] = s.split(":"); sortKey = k; sortAsc = d === "asc"; }
    return Number(p.get("page") || 1) - 1;
  }

  const PRESETS: Record<string, [Record<string, string>, string, boolean]> = {
    drops: [{ off: "30", mcap: "3e8" }, "offHigh", true],
    qualitydrops: [{ off: "20", b5: "0.6", mcap: "3e8" }, "offHigh", true],
    below: [{ status: "below" }, "pts", true],
    buy: [{ status: "BUY" }, "pts", true],
    wonderful: [{ tier: "A" }, "pts", true],
    reset: [{}, "marketCap", false],
  };
  document.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((b) =>
    b.addEventListener("click", () => {
      const [vals, k, asc] = PRESETS[b.dataset.preset!];
      for (const f of FIELDS) set(f, vals[f] ?? "");
      refreshOptions();
      sortKey = k; sortAsc = asc;
      document.querySelectorAll("[data-preset]").forEach((x) => x.classList.toggle("active", x === b && b.dataset.preset !== "reset"));
      filterRows();
    }));

  val("sector")!.addEventListener("change", () => { set("industry", ""); refreshOptions(); });
  form.addEventListener("input", () => { document.querySelectorAll("[data-preset]").forEach((x) => x.classList.remove("active")); filterRows(); });
  document.querySelectorAll<HTMLTableCellElement>("#all th").forEach((th) =>
    th.addEventListener("click", () => {
      const k = th.dataset.k!;
      if (sortKey === k) sortAsc = !sortAsc;
      else { sortKey = k; sortAsc = ["ticker", "status", "tier", "offHigh", "w1", "m1", "m3", "ytd", "y1", "pe", "pts"].includes(k); }
      sortRows();
    }));
  document.getElementById("prev")!.addEventListener("click", () => { page--; render(); window.scrollTo({ top: 0 }); });
  document.getElementById("next")!.addEventListener("click", () => { page++; render(); window.scrollTo({ top: 0 }); });

  document.getElementById("csv")!.addEventListener("click", () => {
    const cols = ["ticker", "name", "exchange", "sector", "industry", "status", "tier", "price", "w1", "m1", "m3", "ytd", "y1", "offHigh", "pe",
      "mos", "sticker", "pts", "payback", "tenCap", "growth", "divYield", "divGrowth5y", "tr10y", "roic5", "big5", "big5Tests", "fcfYield", "marketCap", "detail", "flags", "events"];
    const q = (v: any) => (v == null ? "" : /[",\n]/.test(String(v)) ? `"${String(v).replace(/"/g, '""')}"` : String(v));
    const csv = [cols.join(","), ...view.map((r) => cols.map((c) => q(r[c])).join(","))].join("\n");
    const a = document.createElement("a");
    a.href = URL.createObjectURL(new Blob([csv], { type: "text/csv" }));
    a.download = `ruleone-stocks-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(a.href);
  });

  (async () => {
    const res = await fetch("/data/universe.json");
    const data = await res.json();
    rows = data.rows.map((r: any[]) => Object.fromEntries(data.cols.map((c: string, i: number) => [c, r[i]])));
    refreshOptions();                       // options must exist before saved sector/industry can be restored
    const startPage = loadState();
    refreshOptions();
    for (const f of ["sector", "industry"]) set(f, new URLSearchParams(location.hash.slice(1)).get(f) ?? "");
    filterRows();
    page = Math.min(Math.max(startPage, 0), Math.max(0, Math.ceil(view.length / PAGE) - 1));
    render();
  })();
</script>
