---
import { marked } from "marked";
import Base from "../../layouts/Base.astro";
import { chapterLabel, learnHref, loadBook, loadCourse, loadEpisodes, loadProgress } from "../../lib/data";

const course = loadCourse();
const episodes = loadEpisodes();
const progress = loadProgress();
const book = loadBook();
const bookDone = book.filter((c) => c.status === "notes").length;
const byId = new Map(episodes.map((e) => [e.id, e]));
const modules = (course?.modules ?? []).map((m) => ({
  ...m,
  html: marked.parse(m.lesson || "", { gfm: true }) as string,
  eps: m.episodes.map((id) => byId.get(id)).filter((e) => e != null),
}));
const order = episodes.map((e) => e.id);
const total = progress.total ?? 498;
const pct = Math.round((progress.done.length / total) * 100);
const RULERS: [string, string][] = [
  ["R", "Radar"], ["U", "Understand"], ["L", "Love"], ["E", "Event"], ["Rb", "Reduce basis"], ["S", "Story"],
];
---
<Base title="Learn" description="A structured Rule #1 course built from the InvestED podcast, episode by episode.">
  <h1>Learn: InvestED, in order</h1>
  <p class="muted lede">
    The Professor agent works through every episode of <em>InvestED: The Rule #1 Podcast</em> in order. It writes study notes
    with key ideas, timestamps, exercises and quizzes, and folds each one into the course modules below. These notes are its own words.
    Listen to the episode for the full conversation.
  </p>

  <div class="stats">
    <div class="panel stat">
      <div class="k">Professor's progress</div>
      <div class="v">{progress.done.length} <span class="muted">of {total} episodes</span></div>
      <div class="pbar" role="progressbar" aria-valuenow={pct} aria-valuemin="0" aria-valuemax="100"><span style={`width:${Math.max(pct, 1)}%`}></span></div>
      <div class="muted small">Updated {progress.updated || "n/a"} · about 24 new episodes a day until caught up</div>
    </div>
    <div class="panel stat">
      <div class="k">Your progress</div>
      <div class="v"><span id="mine">0</span> <span class="muted">of {episodes.length} studied</span></div>
      <div class="pbar"><span id="minebar" style="width:0%"></span></div>
      <div class="muted small">Saved in this browser only</div>
    </div>
    <div class="panel stat next">
      <div class="k">Next up</div>
      <a id="next" class="v small-v" href={episodes[0] ? `/learn/${episodes[0].id}/` : "#"}>{episodes[0] ? `${episodes[0].id} · ${episodes[0].title}` : "No notes yet"}</a>
      <div class="muted small">Study in order: read the notes, do the exercise, answer the quiz, then mark the episode studied.</div>
    </div>
  </div>

  <h2>Course</h2>
  <div class="modules">
    {modules.map((m, i) => (
      <details class="panel module" open={i < 2 || undefined} data-module={m.id}>
        <summary>
          <span class="mnum">{i}</span>
          <span class="mtitle">{m.title}</span>
          <span class="muted mcount">{m.eps.length} episode{m.eps.length === 1 ? "" : "s"}</span>
        </summary>
        <p class="muted goal">{m.goal}</p>
        {m.lesson ? <div class="prose lesson" set:html={m.html} /> : <p class="muted">No episodes yet. The Professor fills this in as the show reaches the topic.</p>}
        {m.eps.length > 0 && (
          <ol class="eps">
            {m.eps.map((e) => (
              <li data-ep={e.id}>
                <span class="tick" aria-hidden="true"></span>
                <a href={`/learn/${e.id}/`}>{e.id} · {e.title}</a>
                {e.minutes && <span class="muted small"> · {e.minutes} min</span>}
              </li>
            ))}
          </ol>
        )}
      </details>
    ))}
  </div>

  <h2 id="graham">The Intelligent Investor</h2>
  <p class="muted">
    Benjamin Graham, revised edition with Jason Zweig's commentary. You read and record each chapter, and the Professor turns
    your recording into study notes. Until then, each chapter has a short preview of what to listen for.{" "}
    <strong>{bookDone} of {book.length}</strong> chapters have notes.
  </p>
  <ol class="panel chapters">
    {book.map((c) => (
      <li data-ep={`ii-${c.key}`}>
        <span class="tick" aria-hidden="true"></span>
        <a href={`/learn/graham/${c.key}/`}>{chapterLabel(c.key)}{c.key.startsWith("ch") && ` · ${c.title}`}</a>
        <span class={`chip ${c.status === "notes" ? "BUY" : ""} st`}>{c.status === "notes" ? "notes" : "preview"}</span>
      </li>
    ))}
  </ol>

  <h2>RULERS</h2>
  <p class="muted">Each episode is tagged with the parts of the Rule #1 checklist it teaches. "Reduce basis" means buying in tranches, not options.</p>
  <p>{RULERS.map(([k, v]) => <span class="chip r">{k}</span><span class="rl">{v}</span>)}</p>

  {course && course.glossary.length > 0 && (
    <>
      <h2>Glossary</h2>
      <dl class="gloss">
        {[...course.glossary].sort((a, b) => a.term.localeCompare(b.term)).map((g) => (
          <div class="panel">
            <dt>{g.term}</dt>
            <dd>{g.definition} <span class="muted small">{g.episodes.map((id, j) => <>{j ? ", " : "· "}<a href={learnHref(id)}>{id.startsWith("ii-") ? "II " + chapterLabel(id.slice(3)) : id}</a></>)}</span></dd>
          </div>
        ))}
      </dl>
    </>
  )}
  <p class="muted small">Source: {course?.source}. Notes are written by an AI from automatic transcripts, so names and numbers can be wrong. Not investment advice.</p>
</Base>

<script is:inline define:vars={{ order, titles: Object.fromEntries(episodes.map((e) => [e.id, e.title])) }}>
  let done = [];
  try { done = JSON.parse(localStorage.getItem("ruleone.learn.done") || "[]"); } catch {}
  const set = new Set(done);
  const n = order.filter((id) => set.has(id)).length;
  document.getElementById("mine").textContent = String(n);
  document.getElementById("minebar").style.width = (order.length ? (n / order.length) * 100 : 0) + "%";
  document.querySelectorAll("[data-ep]").forEach((li) => li.classList.toggle("done", set.has(li.dataset.ep)));
  const next = order.find((id) => !set.has(id));
  const a = document.getElementById("next");
  if (next) { a.href = `/learn/${next}/`; a.textContent = `${next} · ${titles[next]}`; }
  else if (order.length) { a.removeAttribute("href"); a.textContent = "All caught up"; }
</script>

<style>
  .lede { max-width: 820px; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; margin: 16px 0 8px; }
  .stat .k { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  .stat .v { font-size: 22px; font-weight: 700; margin: 4px 0 8px; display: block; }
  .stat .small-v { font-size: 16px; text-decoration: none; }
  .small { font-size: 13px; }
  .pbar { height: 8px; background: var(--chip); border-radius: 99px; overflow: hidden; margin-bottom: 6px; }
  .pbar span { display: block; height: 100%; background: var(--accent); }
  .modules { display: grid; gap: 10px; max-width: 900px; }
  .module summary { cursor: pointer; display: flex; gap: 10px; align-items: baseline; font-weight: 600; list-style: none; }
  .module summary::-webkit-details-marker { display: none; }
  .module summary::before { content: "▸"; color: var(--muted); }
  .module[open] summary::before { content: "▾"; }
  .mnum { color: var(--accent); font-variant-numeric: tabular-nums; }
  .mtitle { flex: 1; }
  .mcount { font-weight: 400; font-size: 13px; }
  .goal { margin: 8px 0; }
  .lesson { border-left: 3px solid var(--accent); padding-left: 14px; margin: 8px 0 12px; }
  .eps { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
  .eps li { display: flex; gap: 8px; align-items: baseline; }
  .tick { width: 14px; height: 14px; border: 1.5px solid var(--line); border-radius: 4px; flex: none; transform: translateY(2px); }
  .eps li.done .tick { background: var(--accent); border-color: var(--accent); }
  .eps li.done a { color: var(--muted); }
  .chapters { list-style: none; margin: 0; display: grid; gap: 6px; max-width: 900px; }
  .chapters li { display: flex; gap: 8px; align-items: baseline; }
  .chapters .st { margin-left: auto; font-size: 11px; }
  .chip.r { margin-right: 4px; color: var(--accent); }
  .rl { margin-right: 14px; }
  .gloss { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 8px; }
  .gloss .panel { padding: 10px 14px; }
  .gloss dt { font-weight: 700; }
  .gloss dd { margin: 2px 0 0; }
</style>
