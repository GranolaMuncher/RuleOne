---
import StockTable from "./StockTable.astro";
import { loadUniverse, type Stock, type ListKey } from "../lib/data";

interface Props {
  lists: Record<ListKey, Stock[]>;
  meta: Record<string, any>;
  csvBase?: string;
}
const { lists: rawLists, meta, csvBase } = Astro.props;
// Broad sector / industry from the All stocks table, so older archived runs (whose rows
// only carried the SEC industry text) filter the same way.
const uni = new Map(loadUniverse().map((u) => [u.ticker, u]));
const lists = Object.fromEntries(Object.entries(rawLists).map(([k, rows]) => [k, rows.map((s) => {
  const u = uni.get(s.ticker);
  return u?.sector ? { ...s, sector: u.sector, industry: u.industry || s.industry } : s;
})])) as Record<ListKey, Stock[]>;
const sectorCounts = new Map<string, number>();
for (const s of lists.all_candidates.length ? lists.all_candidates : Object.values(lists).flat())
  if (s.sector) sectorCounts.set(s.sector, (sectorCounts.get(s.sector) ?? 0) + 1);
const sectorOptions = [...sectorCounts].sort((a, b) => a[0].localeCompare(b[0]));
// Industry counts per sector ("" = all sectors), for the dependent Industry dropdown.
const industryCounts: Record<string, Record<string, number>> = { "": {} };
for (const s of lists.all_candidates.length ? lists.all_candidates : Object.values(lists).flat()) {
  if (!s.industry) continue;
  for (const key of ["", s.sector]) {
    industryCounts[key] ??= {};
    industryCounts[key][s.industry] = (industryCounts[key][s.industry] ?? 0) + 1;
  }
}
const sections: { key: ListKey; title: string; blurb: string; limit?: number; status?: boolean }[] = [
  { key: "buy_range", title: "Buy range", blurb: "Price at or below the margin-of-safety price (50% of Sticker). This is Rule #1's strict buy signal." },
  { key: "buy_range_alt_methods", title: "Buy on Payback Time / Ten Cap", blurb: "Below Town's Payback Time or Ten Cap price but not yet below MOS. Treat with care for insurers and brokers, whose cash flow includes float.", limit: 40 },
  { key: "on_deck", title: "On deck", blurb: "Below Sticker but above the buy price. Set alerts at the MOS price.", limit: 40 },
  { key: "event_watch", title: "Event watch", blurb: "Tier A/B businesses with a current event: a ≥20% drawdown, insider buying, an activist 13D or a negative 8-K.", limit: 30, status: true },
  { key: "wonderful_companies", title: "Wonderful companies (tier A)", blurb: "Every tier A business with its current valuation, whatever the price.", status: true },
];
const funnel = [
  ["Listed (NYSE + Nasdaq)", meta.universe],
  ["With SEC XBRL history", meta.with_data],
  ["Passed Big Five screen", meta.stage1],
  ["Fully valued", meta.valued],
];
---
<div class="funnel">
  {funnel.map(([label, v]) => (
    <div class="stat"><div class="v">{v?.toLocaleString?.() ?? "–"}</div><div class="l">{label}</div></div>
  ))}
  <div class="stat hi"><div class="v">{lists.buy_range.length}</div><div class="l">In buy range</div></div>
  <div class="stat"><div class="v">{lists.buy_range_alt_methods.length}</div><div class="l">Buy on Payback / Ten Cap</div></div>
  <div class="stat"><div class="v">{lists.on_deck.length}</div><div class="l">On deck</div></div>
</div>

<div class="filters panel">
  <input type="search" id="q" placeholder="Filter by ticker, name or industry…" aria-label="Filter" />
  <fieldset aria-label="Tier">
    {["A", "B", "C"].map((t) => (
      <label><input type="checkbox" class="tierbox" value={t} checked /> Tier {t}</label>
    ))}
  </fieldset>
  <label class="dy">Sector
    <select id="secfilter">
      <option value="">All sectors</option>
      {sectorOptions.map(([sec, n]) => <option value={sec}>{sec} ({n})</option>)}
    </select>
  </label>
  <label class="dy">Industry
    <select id="indfilter"><option value="">All industries</option></select>
  </label>
  <label class="dy">Market cap
    <select id="mcapfilter">
      <option value="">Any</option>
      <option value="3e8-2e9">Small ($300M–2B)</option>
      <option value="2e9-1e10">Mid ($2B–10B)</option>
      <option value="1e10-2e11">Large ($10B–200B)</option>
      <option value="2e11-">Mega (≥ $200B)</option>
      <option value="1e9-">≥ $1B</option>
      <option value="1e10-">≥ $10B</option>
    </select>
  </label>
  <label class="dy">Off 52w high ≥
    <select id="ddfilter">
      <option value="">Any</option><option value="0.1">10%</option><option value="0.2">20%</option>
      <option value="0.3">30%</option><option value="0.4">40%</option><option value="0.5">50%</option>
    </select>
  </label>
  <label class="dy">P/E ≤
    <select id="pefilter">
      <option value="">Any</option><option value="10">10</option><option value="15">15</option>
      <option value="20">20</option><option value="25">25</option><option value="30">30</option><option value="40">40</option>
    </select>
  </label>
  <label class="dy">Div yield ≥
    <select id="dyfilter">
      <option value="">Any</option><option value="0.0001">Pays dividend</option><option value="0.01">1%</option>
      <option value="0.02">2%</option><option value="0.03">3%</option><option value="0.04">4%</option><option value="0.05">5%</option>
    </select>
  </label>
  <label><input type="checkbox" id="hideflag" /> Hide micro-caps & flagged</label>
</div>

{sections.map((s) => (
  <section id={s.key}>
    <div class="sechead">
      <h2>{s.title} <span class="count">{lists[s.key].length}</span></h2>
      {csvBase && <a class="dl" href={`${csvBase}${s.key}.csv`} download>CSV</a>}
    </div>
    <p class="muted blurb">{s.blurb}</p>
    <StockTable rows={lists[s.key]} id={`t-${s.key}`} limit={s.limit} showStatus={s.status} />
  </section>
))}

<style>
  .funnel { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin: 18px 0; }
  .stat { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; }
  .stat .v { font-size: 22px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .stat .l { color: var(--muted); font-size: 12.5px; }
  .stat.hi { background: var(--buy-bg); border-color: transparent; }
  .stat.hi .v { color: var(--buy); }
  .filters { display: flex; flex-wrap: wrap; gap: 12px 18px; align-items: center; padding: 10px 14px; position: sticky; top: 64px; z-index: 4; }
  .filters input[type="search"] { flex: 1 1 240px; padding: 8px 10px; border-radius: 8px; border: 1px solid var(--line);
    background: var(--bg); color: var(--ink); font: inherit; }
  fieldset { border: 0; padding: 0; margin: 0; display: flex; gap: 12px; }
  label { font-size: 13.5px; color: var(--muted); white-space: nowrap; }
  label.dy { display: flex; align-items: center; gap: 6px; }
  label.dy #indfilter { max-width: 260px; }
  label.dy select { font: inherit; font-size: 13.5px; padding: 5px 8px; border-radius: 8px; border: 1px solid var(--line);
    background: var(--bg); color: var(--ink); }
  .sechead { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .count { color: var(--muted); font-weight: 500; font-size: 15px; }
  .dl { font-size: 13px; }
  .blurb { margin: 0 0 10px; font-size: 13.5px; max-width: 820px; }
</style>

<script type="application/json" id="industry-counts" set:html={JSON.stringify(industryCounts)} />

<script>
  const q = document.getElementById("q") as HTMLInputElement;
  const boxes = [...document.querySelectorAll<HTMLInputElement>(".tierbox")];
  const hideflag = document.getElementById("hideflag") as HTMLInputElement;
  const dyfilter = document.getElementById("dyfilter") as HTMLSelectElement;
  const secfilter = document.getElementById("secfilter") as HTMLSelectElement;
  const indfilter = document.getElementById("indfilter") as HTMLSelectElement;
  const mcapfilter = document.getElementById("mcapfilter") as HTMLSelectElement;
  const pefilter = document.getElementById("pefilter") as HTMLSelectElement;
  const ddfilter = document.getElementById("ddfilter") as HTMLSelectElement;
  // drawdown is stored as a negative fraction (price / 52-week high - 1)
  const inDd = (v: string | undefined) =>
    !ddfilter.value || (!!v && -Number(v) >= Number(ddfilter.value));
  // trailing P/E; loss-makers (no positive P/E) drop out once a cap is chosen
  const inPe = (v: string | undefined) =>
    !pefilter.value || (!!v && Number(v) > 0 && Number(v) <= Number(pefilter.value));
  // "lo-hi" in dollars; empty hi = no upper bound
  const inMcap = (v: string | undefined) => {
    if (!mcapfilter.value) return true;
    if (!v) return false;
    const [lo, hi] = mcapfilter.value.split("-");
    const m = Number(v);
    return m >= Number(lo) && (!hi || m < Number(hi));
  };
  const industryCounts = JSON.parse(document.getElementById("industry-counts")!.textContent!) as Record<string, Record<string, number>>;
  // Industry options follow the chosen sector; the current choice is kept if it still applies.
  function fillIndustries() {
    const keep = indfilter.value;
    const opts = Object.entries(industryCounts[secfilter.value] ?? {}).sort((a, b) => a[0].localeCompare(b[0]));
    indfilter.replaceChildren(new Option("All industries", ""), ...opts.map(([name, n]) => new Option(`${name} (${n})`, name)));
    indfilter.value = opts.some(([name]) => name === keep) ? keep : "";
  }
  secfilter.addEventListener("change", () => { fillIndustries(); apply(); });
  fillIndustries();
  function apply() {
    const term = q.value.trim().toLowerCase();
    const tiers = new Set(boxes.filter((b) => b.checked).map((b) => b.value));
    document.querySelectorAll<HTMLTableRowElement>("table.stocks tbody tr").forEach((tr) => {
      const flagged = !!tr.querySelector(".chip.warn");  // info chips (currency/ADR notes) don't hide
      tr.hidden = !tiers.has(tr.dataset.tier ?? "") || (!!term && !(tr.dataset.search ?? "").includes(term)) ||
        (hideflag.checked && flagged) ||
        (!!dyfilter.value && !(tr.dataset.dy !== "" && Number(tr.dataset.dy) >= Number(dyfilter.value))) ||
        (!!secfilter.value && tr.dataset.sector !== secfilter.value) ||
        (!!indfilter.value && tr.dataset.industry !== indfilter.value) ||
        !inMcap(tr.dataset.mcap) || !inPe(tr.dataset.pe) || !inDd(tr.dataset.dd);
    });
  }
  [q, hideflag, dyfilter, secfilter, indfilter, mcapfilter, pefilter, ddfilter, ...boxes].forEach((el) => el.addEventListener("input", apply));
</script>
